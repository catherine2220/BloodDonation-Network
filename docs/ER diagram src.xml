Table ADMIN {
  AdminID int [pk, increment]
  Name varchar
  Email varchar
  Password varchar
}

Table DONOR {
  DonorID int [pk, increment]
  Name varchar
  Age int
  Gender varchar
  BloodGroup varchar
  Phone varchar
  City varchar
  Availability boolean
}

Table PATIENT {
  PatientID int [pk, increment]
  Name varchar
  BloodGroup varchar
  Phone varchar
  City varchar
}

Table HOSPITAL {
  HospitalID int [pk, increment]
  HospitalName varchar
  Address varchar
  Phone varchar
  City varchar
}

Table BLOOD_REQUEST {
  RequestID int [pk, increment]
  PatientID int [ref: > PATIENT.PatientID]
  HospitalID int [ref: > HOSPITAL.HospitalID]
  BloodGroup varchar
  Units int
  EmergencyLevel varchar
  Status varchar
  Date datetime
}

Table DONATION {
  DonationID int [pk, increment]
  DonorID int [ref: > DONOR.DonorID]
  PatientID int [ref: > PATIENT.PatientID]
  RequestID int [ref: > BLOOD_REQUEST.RequestID]
  Date datetime
  Status varchar
}

Table NOTIFICATION {
  NotificationID int [pk, increment]
  RequestID int [ref: > BLOOD_REQUEST.RequestID]
  DonorID int [ref: > DONOR.DonorID]
  HospitalID int [ref: > HOSPITAL.HospitalID]
  Message varchar
  Status varchar
}